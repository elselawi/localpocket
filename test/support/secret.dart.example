// Template for the local, untracked `secret.dart` fixture.
//
// The `real`-tagged suites (`test/e2e/real/` and the live variants in
// `test/adapters/`) import `test/support/secret.dart`. That file is gitignored
// so credentials never reach the repository, which also means a fresh clone
// cannot compile those suites until you create it.
//
// To run them:
//
//   1. cp test/support/secret.dart.example test/support/secret.dart
//   2. Fill in a PocketBase server you are allowed to write to.
//   3. dart test --tags real --run-skipped -j 1 test/e2e/real/
//
// The suites authenticate against the `_superusers` collection and create,
// mutate, and delete records in the collections they exercise (including the
// `data` collection). Do NOT point them at a server holding real data.

/// Base URL of the PocketBase server under test, without a trailing slash —
/// for example `https://pb.example.com`.
const testPBServer = 'https://pb.example.com';

/// Email of a `_superusers` account on [testPBServer].
const testPBEmail = 'superuser@example.com';

/// Password of the [testPBEmail] account.
const testPBPassword = 'change-me';
