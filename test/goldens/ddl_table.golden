CREATE TABLE "widgets" (
  id TEXT PRIMARY KEY,
  "name" TEXT NOT NULL,
  "qty" INTEGER,
  "price" REAL,
  "active" INTEGER,
  "made_on" INTEGER,
  "size" TEXT CHECK ("size" IN ('S', 'M', 'L')),
  "meta" TEXT,
  "tags" TEXT,
  "owner_id" TEXT,
  "phone" TEXT,
  archived INTEGER NOT NULL DEFAULT 0,
  hidden INTEGER NOT NULL DEFAULT 0,
  extra TEXT
) STRICT;
