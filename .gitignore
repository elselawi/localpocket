# Analysis / build artifacts
.dart_tool/
coverage/
build/
*.iml
.idea/
*.log

# Cloudflare Pages staging output (see tool/deploy_site.mjs)
_site/

# playwright
node_modules

# Generated code
**/*.g.dart

# Scratch/probing code — NOT part of the library or test suite.
probe/

# Benchmark result artifacts (persisted locally for reference, not committed).
# Basename patterns have no slash, so they keep matching even if a result file
# is moved outside benchmark/results/.
benchmark/results/

# Native peer libraries downloaded locally to run the comparative benchmarks
# against other engines (see benchmark/comparative_peers.dart) and the isar
# probes. They are build artifacts of the local machine, not part of the
# library, the package, or the test suite.
benchmark/*.dll
tool/*.dll

# auditing and planning documents
_*.md
/probe_*.dart
/_probe

# secrets
secret.dart